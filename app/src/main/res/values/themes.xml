<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LastWord" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main colors -->
        <item name="colorPrimary">@color/horror_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/crimson</item>
        <item name="android:windowBackground">@color/pure_dark</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        
        <!-- Text appearances -->
        <item name="android:textAppearanceSmall">@style/HorrorText.Small</item>
        <item name="android:textAppearanceMedium">@style/HorrorText.Medium</item>
        <item name="android:textAppearanceLarge">@style/HorrorText.Large</item>
    </style>

    <style name="Theme.LastWord" parent="Base.Theme.LastWord" />

    <style name="HorrorText" parent="android:Widget.TextView">
        <item name="android:textColor">@color/pale_white</item>
        <item name="android:fontFamily">serif</item>
    </style>
    <style name="HorrorText.Small">
        <item name="android:textSize">12sp</item>
    </style>
    <style name="HorrorText.Medium">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="HorrorText.Large">
        <item name="android:textSize">22sp</item>
    </style>

</resources>
