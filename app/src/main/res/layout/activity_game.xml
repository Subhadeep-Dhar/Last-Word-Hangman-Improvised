<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gameRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_dark">

    <!-- Atmospheric Horror Bats & Glowing Eyes Background -->
    <com.example.lastword.utils.HorrorAtmosphereView
        android:id="@+id/horrorAtmosphereView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top HUD Bar: Back Button, Category, Timer, Chances/Attempts (Aligned at 48dp matching other screens) -->
    <LinearLayout
        android:id="@+id/bottomStatsBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_horror_card"
        android:paddingVertical="6dp"
        android:paddingHorizontal="10dp"
        android:layout_marginTop="48dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnGameBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back_arrow"
            android:background="@drawable/bg_button_dark"
            android:contentDescription="Return to Surface"
            android:padding="7dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvGameCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:text="ANIMALS • EASY"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.04"
            android:textAllCaps="true"
            android:gravity="start|center_vertical"
            android:singleLine="true"
            android:ellipsize="end"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGameTimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:text="TIME: --"
            android:textColor="@color/amber_glow"
            android:textSize="14sp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.05"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvGameAttempts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:text="CHANCES: 5"
            android:textColor="@color/horror_red"
            android:textSize="14sp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.05"
            android:textStyle="bold"
            android:gravity="end|center_vertical" />
    </LinearLayout>

    <!-- Cinematic Viewport for Gallows & Hangman (Lifted up directly below top bar) -->
    <FrameLayout
        android:id="@+id/horrorFrame"
        android:layout_width="0dp"
        android:layout_height="195dp"
        android:background="#050505"
        android:clipChildren="true"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/bottomStatsBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/horrorEnvironmentView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0a0a0a" />

        <View
            android:id="@+id/vignetteOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/overlay_vignette"
            android:alpha="0.6"/>

        <com.example.lastword.utils.HangmanView
            android:id="@+id/hangmanView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp" />
    </FrameLayout>

    <!-- Eerie Status / Narrative Line -->
    <TextView
        android:id="@+id/tvHorrorStatusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="16dp"
        android:text="THEY ARE STILL WAITING."
        android:textColor="#FF6666"
        android:textSize="14sp"
        android:letterSpacing="0.06"
        android:textStyle="italic|bold"
        android:fontFamily="serif"
        android:shadowColor="#800000"
        android:shadowRadius="10"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/horrorFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Hidden Word Revealed Slots (Fill in the Blanks intact) -->
    <TextView
        android:id="@+id/tvHiddenWord"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="16dp"
        android:text="_ _ _ _ _"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:letterSpacing="0.22"
        android:textStyle="bold"
        android:shadowColor="#E60000"
        android:shadowRadius="16"
        android:gravity="center"
        android:fontFamily="sans-serif-condensed"
        app:layout_constraintTop_toBottomOf="@id/tvHorrorStatusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Easy Mode Hint / Clue Badge intact -->
    <TextView
        android:id="@+id/tvGameHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="CLUE: ..."
        android:textColor="#FFD54F"
        android:textSize="14sp"
        android:letterSpacing="0.04"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:background="@drawable/bg_horror_card"
        android:paddingHorizontal="14dp"
        android:paddingVertical="5dp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvHiddenWord"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Alphabet Keyboard (Brought up toward the center, lifted well above the footer) -->
    <GridLayout
        android:id="@+id/glAlphabetKeyboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="40dp"
        android:columnCount="7"
        android:rowCount="4"
        android:alignmentMode="alignBounds"
        app:layout_constraintTop_toBottomOf="@id/tvGameHint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.40" />

    <!-- Global Flicker Layer -->
    <View
        android:id="@+id/gameFlickerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:alpha="0.0"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Global Blood Splatter & Dripping Overlay (Topmost, clickable=false) -->
    <com.example.lastword.utils.BloodSplashOverlayView
        android:id="@+id/bloodSplashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
