<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_dark"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvInstructionsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RITUAL INSIGHT"
        android:textColor="@color/horror_red"
        android:textSize="46sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" android:fontFamily="@font/ghastly_panic" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvInstructionsTitle"
        app:layout_constraintBottom_toTopOf="@+id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_horror_card"
            android:padding="16dp">

            <TextView android:letterSpacing="0.15" android:fontFamily="@font/ghastly_panic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="THE RULES OF THE APPARITION:"
                android:textColor="@color/white"
                android:textSize="34sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <TextView android:letterSpacing="0.15" android:fontFamily="@font/ghastly_panic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. You are here to rescue a trapped essence. Choose your destination target wisely: Animals, Horror Movies, or Celebrities.\n\n2. The levels determine sacrifice risk and assistance. Easy provides cryptic clues to assist your guesses. Medium and Hard force you into total psychological darkness without clues.\n\n3. Daily Challenge summons a unique, medium-difficulty tether once per local day. Each daily outcome is etched permanently into your record once.\n\n4. Select a ritual mode. Classic allows you to guess carefully through errors. Timer Mode accelerates reality, imposing an unyielding time limit before permanent failure is cast.\n\n5. Select keys from the grid. Correct choices reveal letters; completing the word severs the rope to set them free. Wrong selections or running out of time seal their doom and tally a Kill.\n\n6. The Soul Registry preserves your total rituals, saved lives, kills, resonance scores, and rescue streaks offline on this device."
                android:textColor="@color/pale_white"
                android:textSize="30sp"
                android:lineSpacingMultiplier="1.2"/>
        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton android:textSize="28sp"
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="RETURN TO SURFACE"
        android:textColor="@color/pale_white"
        android:background="@drawable/bg_button_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

