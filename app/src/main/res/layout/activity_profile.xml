<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_dark"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvProfileTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SOUL RECORD"
        android:textColor="@color/horror_red"
        android:textSize="46sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" android:fontFamily="@font/ghastly_panic" />

    <TextView android:letterSpacing="0.15" android:fontFamily="@font/ghastly_panic"
        android:id="@+id/tvUsernameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Subject: Unknown"
        android:textColor="@color/white"
        android:textSize="38sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvProfileTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/statsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_horror_card"
        android:padding="16dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvUsernameLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:letterSpacing="0.15" android:fontFamily="@font/ghastly_panic"
            android:id="@+id/tvPlayed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RITUALS PERFORMED: 0"
            android:textColor="@color/pale_white"
            android:textSize="32sp"
            android:layout_marginBottom="8dp"/>

        <TextView android:letterSpacing="0.15" android:fontFamily="@font/ghastly_panic"
            android:id="@+id/tvWins"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SOULS SAVED: 0"
            android:textColor="@color/pale_white"
            android:textSize="32sp"
            android:layout_marginBottom="8dp"/>

        <TextView android:letterSpacing="0.15" android:fontFamily="@font/ghastly_panic"
            android:id="@+id/tvLosses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TOTAL SACRIFICES / KILLS CAUSED: 0"
            android:textColor="@color/horror_red"
            android:textSize="32sp"
            android:layout_marginBottom="8dp"/>

        <TextView android:letterSpacing="0.15" android:fontFamily="@font/ghastly_panic"
            android:id="@+id/tvWinRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SURVIVAL RATE: 0%"
            android:textColor="@color/pale_white"
            android:textSize="32sp"
            android:layout_marginBottom="8dp"/>

        <TextView android:letterSpacing="0.15" android:fontFamily="@font/ghastly_panic"
            android:id="@+id/tvBestScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HIGHEST RITUAL RESONANCE: 0"
            android:textColor="@color/amber_glow"
            android:textSize="32sp"
            android:layout_marginBottom="8dp"/>

        <TextView android:letterSpacing="0.15" android:fontFamily="@font/ghastly_panic"
            android:id="@+id/tvStreak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CURRENT SAVING STREAK: 0"
            android:textColor="@color/pale_white"
            android:textSize="32sp"/>
    </LinearLayout>

    <TextView android:fontFamily="@font/ghastly_panic"
        android:id="@+id/tvAchievementsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UNLOCKED MARKS (ACHIEVEMENTS)"
        android:textColor="@color/dim_gray"
        android:textSize="31sp"
        android:letterSpacing="0.05"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/statsCard"
        app:layout_constraintStart_toStartOf="parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvAchievementsLabel"
        app:layout_constraintBottom_toTopOf="@+id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/achievementsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Dynamically populated or custom hardcoded items for stability -->
        </LinearLayout>
    </ScrollView>

    <Button android:textSize="22sp"
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="RETURN TO SURFACE"
        android:textColor="@color/pale_white"
        android:background="@drawable/bg_button_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
