<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_dark">

    <!-- Atmospheric Horror Bats & Glowing Eyes Background -->
    <com.example.lastword.utils.HorrorAtmosphereView
        android:id="@+id/horrorAtmosphereView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ambient Blood Splatters on Wall Background -->
    <com.example.lastword.utils.BloodSplashOverlayView
        android:id="@+id/bloodSplashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Secondary Entry Point: Settings Icon (Top Right) -->
    <ImageButton
        android:id="@+id/btnSettingsIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_settings"
        android:background="@drawable/bg_button_dark"
        android:contentDescription="Settings"
        android:padding="10dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Center Content Group -->
    <LinearLayout
        android:id="@+id/centerGroup"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnSettingsIcon"
        app:layout_constraintBottom_toTopOf="@+id/llOverallSummary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.52">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LAST WORD"
            android:textColor="@color/horror_red"
            android:textSize="70sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:fontFamily="@font/ghastly_panic" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Can you save them?"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.14"
            android:shadowColor="#CC0000"
            android:shadowRadius="14"
            android:fontFamily="@font/ghastly_panic"/>

        <!-- 4 Primary Destinations -->
        <LinearLayout
            android:id="@+id/menuLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp">

            <!-- 1. Play Game -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEnterGame"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="PLAY GAME"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button_dark"/>

            <!-- 2. Daily Challenge -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDailyChallenge"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="DAILY CHALLENGE"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button_dark"/>

            <!-- 3. Score & Stats -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnScoreStats"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="SCORE &amp; STATS"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_button_dark"/>

            <!-- 4. Help / Instructions -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnInstructions"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="HELP / INSTRUCTIONS"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:background="@drawable/bg_button_dark"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Overall Summary Footer -->
    <LinearLayout
        android:id="@+id/llOverallSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_horror_card"
        android:padding="12dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvFooterGames"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RITUALS: 0 | SAVED: 0 | KILLS: 0"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvFooterStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STREAK: 0 | HIGHEST SCORE: 0"
            android:textColor="@color/amber_glow"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:textSize="15sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <View
        android:id="@+id/flickerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:alpha="0.0"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>
