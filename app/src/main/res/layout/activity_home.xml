<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_dark"
    android:padding="24dp">

    <!-- Center Content Group -->
    <LinearLayout
        android:id="@+id/centerGroup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/llUserStats"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LAST WORD"
            android:textColor="@color/horror_red"
            android:textSize="74sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:fontFamily="@font/ghastly_panic" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Can you save them?"
            android:textColor="@color/pale_white"
            android:textSize="36sp"
            android:textStyle="italic"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.15"
            android:fontFamily="@font/ghastly_panic"/>

        <LinearLayout
            android:id="@+id/menuLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="40dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEnterGame"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="ENTER THE VOID"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_button_dark"/>

            <androidx.appcompat.widget.AppCompatButton android:textSize="28sp"
                android:id="@+id/btnProfile"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="SOUL RECORD (PROFILE)"
                android:textColor="@color/pale_white"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_button_dark"/>

            <androidx.appcompat.widget.AppCompatButton android:textSize="28sp"
                android:id="@+id/btnLeaderboard"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="WALL OF KILLS (LEADERBOARD)"
                android:textColor="@color/pale_white"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_button_dark"/>

            <androidx.appcompat.widget.AppCompatButton android:textSize="28sp"
                android:id="@+id/btnInstructions"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="RITUAL INSIGHT (HOW TO PLAY)"
                android:textColor="@color/pale_white"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_button_dark"/>

            <androidx.appcompat.widget.AppCompatButton android:textSize="28sp"
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="ALTER ENVIRONMENT (SETTINGS)"
                android:textColor="@color/pale_white"
                android:background="@drawable/bg_button_dark"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Detailed Stats Dashboard -->
    <LinearLayout
        android:id="@+id/llUserStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:fontFamily="@font/ghastly_panic"
            android:id="@+id/tvActiveSubject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active Subject: ..."
            android:textColor="@color/dim_gray"
            android:letterSpacing="0.15"
            android:textSize="31sp" />

        <TextView android:fontFamily="@font/ghastly_panic"
            android:id="@+id/tvAnimalsStat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Animals: 0 Saved | 0 Sacrificed"
            android:textColor="@color/pale_white"
            android:letterSpacing="0.15"
            android:textSize="24sp" />

        <TextView android:fontFamily="@font/ghastly_panic"
            android:id="@+id/tvAdultsStat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adults: 0 Saved | 0 Murdered"
            android:textColor="@color/pale_white"
            android:letterSpacing="0.15"
            android:textSize="24sp" />

        <TextView android:fontFamily="@font/ghastly_panic"
            android:id="@+id/tvChildrenStat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Children: 0 Saved | 0 Lost"
            android:textColor="@color/horror_red"
            android:letterSpacing="0.15"
            android:textSize="24sp" />
    </LinearLayout>

    <View
        android:id="@+id/flickerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:alpha="0.0"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>

