<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_dark">

        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LAST WORD"
            android:textColor="@color/horror_red"
            android:textSize="80sp"
            android:textStyle="bold"
            android:letterSpacing="0.3"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"  android:fontFamily="@font/ghastly_panic" />

    <TextView android:fontFamily="@font/ghastly_panic"
        android:id="@+id/tvSplashSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Every mistake has a consequence."
        android:textColor="@color/dim_gray"
        android:textSize="36sp"
        android:letterSpacing="0.1"
        android:textStyle="italic"
        android:alpha="0"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvSplashTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/flickerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:alpha="0.0"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
