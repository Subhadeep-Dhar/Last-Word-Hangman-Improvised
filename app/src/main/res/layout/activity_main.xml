<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030303">

    <!-- Atmospheric Horror Bats & Glowing Eyes Background -->
    <com.example.lastword.utils.HorrorAtmosphereView
        android:id="@+id/horrorAtmosphereView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Atmospheric swinging flickering lamp & light beam -->
    <com.example.lastword.utils.HorrorLampView
        android:id="@+id/horrorLampView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/titleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LAST WORD"
            android:textColor="@color/horror_red"
            android:textSize="85sp"
            android:textStyle="bold"
            android:letterSpacing="0.25"
            android:alpha="0"
            android:shadowColor="#E60000"
            android:shadowRadius="24"
            android:shadowDx="0"
            android:shadowDy="0"
            android:fontFamily="@font/ghastly_panic" />

        <TextView
            android:id="@+id/tvSplashSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Every mistake has a consequence."
            android:textColor="@color/white"
            android:textSize="16sp"
            android:letterSpacing="0.08"
            android:textStyle="italic|bold"
            android:fontFamily="serif"
            android:alpha="0"
            android:shadowColor="#000000"
            android:shadowRadius="12"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <View
        android:id="@+id/flickerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:alpha="0.0"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
