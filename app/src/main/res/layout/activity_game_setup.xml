<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_dark">

    <!-- Atmospheric Horror Bats & Glowing Eyes Background -->
    <com.example.lastword.utils.HorrorAtmosphereView
        android:id="@+id/horrorAtmosphereView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ambient Blood Splatters on Wall Background -->
    <com.example.lastword.utils.BloodSplashOverlayView
        android:id="@+id/bloodSplashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Left Quick Back Button -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_back_arrow"
        android:background="@drawable/bg_button_dark"
        android:contentDescription="Return"
        android:padding="10dp"
        android:layout_marginTop="50dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvSetupTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CHOOSE YOUR FATE"
        android:textColor="@color/horror_red"
        android:textSize="44sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:layout_marginTop="52dp"
        android:fontFamily="@font/ghastly_panic"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/tvSetupTitle"
        app:layout_constraintBottom_toTopOf="@+id/btnEnterRoom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Category Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT CATEGORY"
                android:textColor="@color/horror_red"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"/>

            <RadioGroup
                android:id="@+id/rgCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_horror_card"
                android:padding="12dp"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:id="@+id/rbAnimals"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="ANIMALS"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/white"
                    android:buttonTint="@color/horror_red"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rbHorrorMovies"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="HORROR MOVIES"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/white"
                    android:buttonTint="@color/horror_red"/>

                <RadioButton
                    android:id="@+id/rbCelebrities"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="CELEBRITIES"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/white"
                    android:buttonTint="@color/horror_red"/>
            </RadioGroup>

            <!-- Difficulty Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT DIFFICULTY"
                android:textColor="@color/horror_red"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"/>

            <RadioGroup
                android:id="@+id/rgDifficulty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_horror_card"
                android:padding="12dp"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:id="@+id/rbEasy"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="EASY - LONGER TETHER (WITH HINTS)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/white"
                    android:buttonTint="@color/horror_red"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rbIntermediate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="MEDIUM - STANDARD SACRIFICE"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/white"
                    android:buttonTint="@color/horror_red"/>

                <RadioButton
                    android:id="@+id/rbHard"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="HARD - PSYCHOLOGICAL DREAD"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/white"
                    android:buttonTint="@color/horror_red"/>
            </RadioGroup>

            <!-- Mode Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT RITUAL MODE"
                android:textColor="@color/horror_red"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp"/>

            <RadioGroup
                android:id="@+id/rgMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_horror_card"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/rbClassic"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="CLASSIC (ATTEMPTS LIMIT ONLY)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/white"
                    android:buttonTint="@color/horror_red"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rbTimer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="TIMER MODE (TICKING DEATH)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/white"
                    android:buttonTint="@color/horror_red"/>
            </RadioGroup>

        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnEnterRoom"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:text="ENTER THE ROOM"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="0.08"
        android:background="@drawable/bg_button_dark"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
