<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/resultRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/buttonLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvResultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOU SAVED THEM."
            android:textColor="@color/white"
            android:textSize="120sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            
            android:gravity="center"
            android:layout_marginBottom="24dp" android:fontFamily="@font/ghastly_panic" />

        <TextView android:fontFamily="@font/ghastly_panic"
            android:id="@+id/tvResultWord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WORD: XXXXX"
            android:textColor="@color/dim_gray"
            android:textSize="72sp"
            android:letterSpacing="0.1"
            android:layout_marginBottom="32dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_horror_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView android:fontFamily="@font/ghastly_panic"
                android:id="@+id/tvBaseScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BASE SCORE: 0"
                android:textColor="@color/pale_white"
                android:textSize="48sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <TextView android:fontFamily="@font/ghastly_panic"
                android:id="@+id/tvAccuracyBonus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ACCURACY BONUS: 0"
                android:textColor="@color/pale_white"
                android:textSize="48sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <TextView android:fontFamily="@font/ghastly_panic"
                android:id="@+id/tvTimeBonus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TIME BONUS: 0"
                android:textColor="@color/pale_white"
                android:textSize="48sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/horror_red"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvFinalScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOTAL RITUAL SCORE: 0"
                android:textColor="@color/horror_red"
                android:textSize="80sp"
                android:letterSpacing="0.1"
                android:fontFamily="@font/ghastly_panic"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton android:textSize="28sp"
            android:id="@+id/btnPlayAgain"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="TRY AGAIN"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_dark"
            android:layout_marginBottom="12dp"/>

        <androidx.appcompat.widget.AppCompatButton android:textSize="28sp"
            android:id="@+id/btnHome"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="RETURN TO SURFACE"
            android:textColor="@color/pale_white"
            android:background="@drawable/bg_button_dark"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

