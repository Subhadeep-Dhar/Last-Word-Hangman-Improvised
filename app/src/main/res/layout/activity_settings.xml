<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_dark">

    <!-- Top Left Quick Back Button -->
    <ImageButton
        android:id="@+id/btnTopBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_back_arrow"
        android:background="@drawable/bg_button_dark"
        android:contentDescription="Return"
        android:padding="10dp"
        android:layout_marginTop="52dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvSettingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ALTER ENVIRONMENT"
        android:textColor="@color/horror_red"
        android:textSize="46sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginTop="54dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fontFamily="@font/ghastly_panic" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_horror_card"
        android:padding="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <CheckBox
            android:id="@+id/cbMusic"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="AMBIENT ATMOSPHERE DRONE (MUSIC)"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:buttonTint="@color/horror_red"
            android:checked="true"/>

        <CheckBox
            android:id="@+id/cbSound"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="TACTILE FEEDBACK TONES (SOUND EFFECTS)"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:buttonTint="@color/horror_red"
            android:checked="true"/>

        <CheckBox
            android:id="@+id/cbVibration"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="PULSE INDUCTION (VIBRATION)"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:buttonTint="@color/horror_red"
            android:checked="true"/>

        <CheckBox
            android:id="@+id/cbDarkMode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="ABSOLUTE COLD DARK ROOMS (DARK THEME)"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:buttonTint="@color/horror_red"
            android:checked="true"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/crimson_border"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnResetData"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="RESET ALL GAME DATA"
            android:textColor="@color/horror_red"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:background="@drawable/bg_button_dark"/>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBack"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="RETURN TO SURFACE"
        android:textColor="@color/pale_white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="0.08"
        android:background="@drawable/bg_button_dark"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

