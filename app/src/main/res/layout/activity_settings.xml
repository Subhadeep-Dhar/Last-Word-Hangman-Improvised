<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_dark"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvSettingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ALTER ENVIRONMENT"
        android:textColor="@color/horror_red"
        android:textSize="46sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" android:fontFamily="@font/ghastly_panic" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_horror_card"
        android:padding="20dp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <CheckBox
            android:id="@+id/cbMusic"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="AMBIENT ATMOSPHERE DRONE (MUSIC)"
            android:textColor="@color/pale_white"
            android:buttonTint="@color/horror_red"
            android:checked="true"/>

        <CheckBox
            android:id="@+id/cbSound"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="TACTILE FEEDBACK TONES (SOUND EFFECTS)"
            android:textColor="@color/pale_white"
            android:buttonTint="@color/horror_red"
            android:checked="true"/>

        <CheckBox
            android:id="@+id/cbVibration"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="PULSE INDUCTION (VIBRATION)"
            android:textColor="@color/pale_white"
            android:buttonTint="@color/horror_red"
            android:checked="true"/>

        <CheckBox
            android:id="@+id/cbDarkMode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="ABSOLUTE COLD DARK ROOMS (DARK THEME)"
            android:textColor="@color/pale_white"
            android:buttonTint="@color/horror_red"
            android:checked="true"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/dim_gray"
            android:layout_marginVertical="16dp"/>

        <Button android:textSize="22sp"
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SEVER SUBJECT SESSION (LOGOUT)"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_dark"/>
    </LinearLayout>

    <Button android:textSize="22sp"
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="RETURN TO SURFACE"
        android:textColor="@color/pale_white"
        android:background="@drawable/bg_button_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
